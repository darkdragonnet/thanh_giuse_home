{
  "name": "thanh-giuse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mock": "npm run dev --workspace=apps/hanet-mock",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:worker": "npm run dev --workspace=apps/worker",
    "build": "npm run build --workspaces --if-present",
    "build:mock": "npm run build --workspace=apps/hanet-mock",
    "test": "npm run test --workspaces --if-present",
    "test:mock": "npm run test --workspace=apps/hanet-mock",
    "verify:mock": "cd apps/hanet-mock && bash tests/curl/verify.sh",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist packages/*/dist"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
