# ==============================================================================
# HỆ THỐNG ONBOARDING ĐĂNG KÝ KHUÔN MẶT HỌC SINH (HANET CLOUD INTEGRATION)
# Tệp cấu hình biến môi trường mẫu (Copy thành .env khi triển khai)
# ==============================================================================

# Node Environment
NODE_ENV=development
API_PORT=3000
PROXY_PORT=8090

# Node process memory bounds (Principle I & II: 384MB cho API, 512MB cho Worker)
NODE_OPTIONS="--max-old-space-size=512"

# ------------------------------------------------------------------------------
# POSTGRESQL CONFIGURATION
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=thanh_giuse_db
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=super_secure_postgres_password_change_me

# Connection String định dạng tiêu chuẩn (dùng cho Kysely / pg pool)
DATABASE_URL=postgresql://postgres_user:super_secure_postgres_password_change_me@postgres:5432/thanh_giuse_db

# ------------------------------------------------------------------------------
# REDIS CONFIGURATION (BullMQ Broker & Sliding Window Rate Limiting)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=super_secure_redis_password_change_me
REDIS_URL=redis://:super_secure_redis_password_change_me@redis:6379/0

# ------------------------------------------------------------------------------
# HANET CLOUD OPEN API CREDENTIALS
# ------------------------------------------------------------------------------
HANET_API_BASE_URL=https://partner.hanet.ai
HANET_CLIENT_ID=your_hanet_client_id_here
HANET_CLIENT_SECRET=your_hanet_client_secret_here
HANET_ACCESS_TOKEN=your_hanet_access_token_here
HANET_PLACE_ID=your_hanet_place_id_here

# ------------------------------------------------------------------------------
# STORAGE & APPLICATION LIMITS
# ------------------------------------------------------------------------------
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_BYTES=5242880 # 5MB Nginx / Express limit
STATIC_BASE_URL=http://161.248.146.115:8090/tmp-faces
HANET_SYNC_RATE_LIMIT=1 # 1 request / phút (pacing điều tiết đồng bộ nền FR-007)

# Security & Sessions
JWT_SECRET=super_secret_jwt_key_for_admin_session_change_me
